# EditorConfig for codetracer-nim
# Nim uses flexible indentation that doesn't always align to 2-space multiples
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.nim]
indent_size = unset

[*.md]
trim_trailing_whitespace = false
indent_size = unset
